  identifier="stats-04" title="The biggest residual" adaptive="false" time-dependent="false" xml:lang="en">
  <qti-response-declaration identifier="RESPONSE" cardinality="single" base-type="identifier">
    <qti-correct-response>
      <qti-value>P10</qti-value>
    </qti-correct-response>
  </qti-response-declaration>
  <qti-outcome-declaration identifier="SCORE" cardinality="single" base-type="float">
    <qti-default-value>
      <qti-value>0</qti-value>
    </qti-default-value>
  </qti-outcome-declaration>
  <qti-outcome-declaration identifier="MAXSCORE" cardinality="single" base-type="float">
    <qti-default-value>
      <qti-value>1</qti-value>
    </qti-default-value>
  </qti-outcome-declaration>
  <qti-stylesheet href="stats.css" type="text/css"/>
  <qti-item-body>
    <p>For 15 students, a researcher measured attention during a lecture and performance on the exam that followed. The line is the least-squares regression line; the dashed lines are the residuals.</p>
    <qti-hotspot-interaction response-identifier="RESPONSE" max-choices="1">
      <qti-prompt>Click the observation that contributes most to the residual sum of squares, <em>SSE</em>.</qti-prompt>
      <img src="images/residuals.svg" width="520" height="362" alt="A scatterplot of Attention, from 0 to 50, against Performance, from 0 to 60, with fifteen observations and a fitted regression line rising from left to right. Dashed vertical lines connect each observation to the line. Most observations lie close to the line. One observation, at an attention score of 30, lies far below the line. Another, at about 38, lies somewhat above it."/>
      <qti-hotspot-choice identifier="P01" shape="circle" coords="108,240,11"/>
      <qti-hotspot-choice identifier="P02" shape="circle" coords="134,235,11"/>
