<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqtiasi_v3p0 https://purl.imsglobal.org/spec/qti/v3p0/schema/xsd/imsqti_asiv3p0_v1p0.xsd"
  identifier="reading-b1" title="Reading the dance" adaptive="false" time-dependent="false" xml:lang="en">
  <qti-response-declaration identifier="RESPONSE" cardinality="single" base-type="identifier">
    <qti-correct-response>
      <qti-value>DISTANCE</qti-value>
    </qti-correct-response>
  </qti-response-declaration>
  <qti-outcome-declaration identifier="SCORE" cardinality="single" base-type="float">
    <qti-default-value>
      <qti-value>0</qti-value>
    </qti-default-value>
  </qti-outcome-declaration>
  <qti-outcome-declaration identifier="MAXSCORE" cardinality="single" base-type="float">
    <qti-default-value>
      <qti-value>1</qti-value>
    </qti-default-value>
  </qti-outcome-declaration>
  <qti-assessment-stimulus-ref identifier="stimulus-bees" href="stimulus-bees.xml" title="Why Bees Dance"/>
  <qti-item-body>
    <div class="qti-layout-row">
      <div class="qti-layout-col6">
        <div class="qti-shared-stimulus" data-stimulus-idref="stimulus-bees"></div>
      </div>
      <div class="qti-layout-col6">
        <qti-choice-interaction response-identifier="RESPONSE" shuffle="true" max-choices="1">
          <qti-prompt>What does the <strong>length</strong> of the waggle tell the other bees?</qti-prompt>
          <qti-simple-choice identifier="DISTANCE">How far away the flowers are.</qti-simple-choice>
          <qti-simple-choice identifier="DIRECTION">Which way to fly from the hive.</qti-simple-choice>
          <qti-simple-choice identifier="COUNT">How many flowers there are.</qti-simple-choice>
          <qti-simple-choice identifier="SMELL">What the flowers smell like.</qti-simple-choice>
        </qti-choice-interaction>
      </div>
    </div>
  </qti-item-body>
  <qti-response-processing template="https://purl.imsglobal.org/spec/qti/v3p0/rptemplates/match_correct.xml"/>
</qti-assessment-item>
