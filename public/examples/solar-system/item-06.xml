<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqtiasi_v3p0 https://purl.imsglobal.org/spec/qti/v3p0/schema/xsd/imsqti_asiv3p0_v1p0.xsd"
  identifier="solar-06" title="Once around the Sun" adaptive="false" time-dependent="false" xml:lang="en">
  <qti-response-declaration identifier="RESPONSE" cardinality="single" base-type="identifier">
    <qti-correct-response>
      <qti-value>YEAR</qti-value>
    </qti-correct-response>
  </qti-response-declaration>
  <qti-outcome-declaration identifier="SCORE" cardinality="single" base-type="float">
    <qti-default-value>
      <qti-value>0</qti-value>
    </qti-default-value>
  </qti-outcome-declaration>
  <qti-outcome-declaration identifier="MAXSCORE" cardinality="single" base-type="float">
    <qti-default-value>
      <qti-value>1</qti-value>
    </qti-default-value>
  </qti-outcome-declaration>
  <qti-item-body>
    <p class="qti-align-center">
      <img src="images/earth-orbit.svg" width="480" height="260" alt="The Earth, with its Moon, travelling along an oval path around the Sun. An arrow shows the direction of travel."/>
    </p>
    <p>Choose the word that makes this sentence correct.</p>
    <p>The Earth takes about one
      <qti-inline-choice-interaction response-identifier="RESPONSE" shuffle="true">
        <qti-inline-choice identifier="DAY">day</qti-inline-choice>
        <qti-inline-choice identifier="MONTH">month</qti-inline-choice>
        <qti-inline-choice identifier="YEAR">year</qti-inline-choice>
        <qti-inline-choice identifier="CENTURY">century</qti-inline-choice>
      </qti-inline-choice-interaction>
      to travel once all the way around the Sun.</p>
  </qti-item-body>
  <qti-response-processing template="https://purl.imsglobal.org/spec/qti/v3p0/rptemplates/match_correct.xml"/>
</qti-assessment-item>
