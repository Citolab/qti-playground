<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqtiasi_v3p0 https://purl.imsglobal.org/spec/qti/v3p0/schema/xsd/imsqti_asiv3p0_v1p0.xsd"
  identifier="solar-04" title="Lord of the rings" adaptive="false" time-dependent="false" xml:lang="en">
  <qti-response-declaration identifier="RESPONSE" cardinality="single" base-type="identifier">
    <qti-correct-response>
      <qti-value>SATURN</qti-value>
    </qti-correct-response>
  </qti-response-declaration>
  <qti-outcome-declaration identifier="SCORE" cardinality="single" base-type="float">
    <qti-default-value>
      <qti-value>0</qti-value>
    </qti-default-value>
  </qti-outcome-declaration>
  <qti-outcome-declaration identifier="MAXSCORE" cardinality="single" base-type="float">
    <qti-default-value>
      <qti-value>1</qti-value>
    </qti-default-value>
  </qti-outcome-declaration>
  <qti-item-body>
    <p>Several planets have rings, but one planet is famous for its wide, bright rings made of ice and rock.</p>
    <qti-hotspot-interaction response-identifier="RESPONSE" max-choices="1">
      <qti-prompt>Click the planet with the most famous rings.</qti-prompt>
      <img src="images/solar-system.svg" width="648" height="270" alt="The Sun on the left with eight planets on their orbits: a small grey planet, a pale yellow planet, a blue and green planet with a moon, a small red planet, a large striped planet, a golden planet with wide rings, a pale blue-green planet with a faint upright ring, and a deep blue planet."/>
      <qti-hotspot-choice identifier="MERCURY" shape="circle" coords="104,85,13"/>
      <qti-hotspot-choice identifier="VENUS" shape="circle" coords="127,212,16"/>
      <qti-hotspot-choice identifier="EARTH" shape="circle" coords="178,105,18"/>
      <qti-hotspot-choice identifier="MARS" shape="circle" coords="201,212,14"/>
      <qti-hotspot-choice identifier="JUPITER" shape="circle" coords="279,79,36"/>
      <qti-hotspot-choice identifier="SATURN" shape="circle" coords="381,209,45"/>
      <qti-hotspot-choice identifier="URANUS" shape="circle" coords="478,72,25"/>
      <qti-hotspot-choice identifier="NEPTUNE" shape="circle" coords="559,198,22"/>
    </qti-hotspot-interaction>
  </qti-item-body>
  <qti-response-processing template="https://purl.imsglobal.org/spec/qti/v3p0/rptemplates/match_correct.xml"/>
</qti-assessment-item>
