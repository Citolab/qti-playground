<?xml version="1.0" encoding="UTF-8"?>
<qti-assessment-item xmlns="http://www.imsglobal.org/xsd/imsqtiasi_v3p0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.imsglobal.org/xsd/imsqtiasi_v3p0 https://purl.imsglobal.org/spec/qti/v3p0/schema/xsd/imsqti_asiv3p0_v1p0.xsd"
  identifier="solar-01" title="The Red Planet" adaptive="false" time-dependent="false" xml:lang="en">
  <qti-response-declaration identifier="RESPONSE" cardinality="single" base-type="identifier">
    <qti-correct-response>
      <qti-value>MARS</qti-value>
    </qti-correct-response>
  </qti-response-declaration>
  <qti-outcome-declaration identifier="SCORE" cardinality="single" base-type="float">
    <qti-default-value>
      <qti-value>0</qti-value>
    </qti-default-value>
  </qti-outcome-declaration>
  <qti-outcome-declaration identifier="MAXSCORE" cardinality="single" base-type="float">
    <qti-default-value>
      <qti-value>1</qti-value>
    </qti-default-value>
  </qti-outcome-declaration>
  <qti-stylesheet href="space.css" type="text/css"/>
  <qti-item-body>
    <p>Mars is often called <em>the Red Planet</em>. Its surface is covered in dust that contains a lot of iron oxide &#8211; the same stuff that makes rust.</p>
    <qti-choice-interaction response-identifier="RESPONSE" shuffle="true" max-choices="1" class="qti-choices-stacking-2 qti-input-control-hidden">
      <qti-prompt>Which of these planets is Mars?</qti-prompt>
      <qti-simple-choice identifier="VENUS">
        <img src="images/venus.svg" width="120" height="120" alt="A pale yellow planet wrapped in swirling creamy clouds."/>
      </qti-simple-choice>
      <qti-simple-choice identifier="MARS">
        <img src="images/mars.svg" width="120" height="120" alt="A rusty red planet with dark patches and a white polar cap."/>
      </qti-simple-choice>
      <qti-simple-choice identifier="NEPTUNE">
        <img src="images/neptune.svg" width="120" height="120" alt="A deep blue planet with soft stripes and a dark storm spot."/>
      </qti-simple-choice>
      <qti-simple-choice identifier="JUPITER">
        <img src="images/jupiter.svg" width="120" height="120" alt="A huge planet striped in cream, orange and brown bands, with a big red oval spot."/>
      </qti-simple-choice>
    </qti-choice-interaction>
  </qti-item-body>
  <qti-response-processing template="https://purl.imsglobal.org/spec/qti/v3p0/rptemplates/match_correct.xml"/>
</qti-assessment-item>
